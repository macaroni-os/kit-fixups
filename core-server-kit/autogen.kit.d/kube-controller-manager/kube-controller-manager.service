[Unit]
Description=kube-controller-manager: The Kubernetes controller manager
Documentation=https://kubernetes.io/docs/home/
Wants=network-online.target
After=network-online.target
After=kube-apiserver.service

[Service]
EnvironmentFile=-/etc/conf.d/kube-controller-manager
ExecStart=/usr/bin/kube-controller-manager $KUBECONTROLLERMANAGER_KUBECONFIG_ARGS $KUBECONTROLLERMANAGER_ARGS
Restart=always
StartLimitInterval=0
RestartSec=10

[Install]
WantedBy=multi-user.target
