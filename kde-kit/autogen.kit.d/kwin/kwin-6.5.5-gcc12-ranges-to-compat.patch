From: 
Date: Tue, 14 Jan 2026 00:00:00 +0000
Subject: [PATCH] Fix compatibility with GCC12

--- a/src/compositor.cpp
+++ b/src/compositor.cpp
@@ -323,9 +323,17 @@ void Compositor::stop()
         static_cast<EglBackend *>(m_backend.get())->openglContext()->makeCurrent();
     }

+#if defined(__cpp_lib_ranges_to_container) && __cpp_lib_ranges_to_container >= 202202L
     const auto loops = m_primaryViews | std::views::transform([](const auto &pair) {
         return pair.first;
     }) | std::ranges::to<QList>();
+#else
+    
+    auto range = m_primaryViews | std::views::transform([](const auto &pair) {
+        return pair.first;
+    });
+    const QList<RenderLoop *> loops(range.begin(), range.end());
+#endif
     for (RenderLoop *loop : loops) {
         removeOutput(findOutput(loop));
     }
@@ -737,10 +745,19 @@ void Compositor::composite(RenderLoop *renderLoop)
         }
     }

+#if defined(__cpp_lib_ranges_to_container) && __cpp_lib_ranges_to_container >= 202202L
     QList<OutputLayer *> specialLayers = unusedOutputLayers | std::views::filter([cursorLayer](OutputLayer *layer) {
         return layer->type() != OutputLayerType::Primary
             && (!cursorLayer || layer->minZpos() < cursorLayer->zpos());
     }) | std::ranges::to<QList>();
+#else
+    
+    auto filteredRange = unusedOutputLayers | std::views::filter([cursorLayer](OutputLayer *layer) {
+        return layer->type() != OutputLayerType::Primary
+            && (!cursorLayer || layer->minZpos() < cursorLayer->zpos());
+    });
+    QList<OutputLayer *> specialLayers(filteredRange.begin(), filteredRange.end());
+#endif
     std::ranges::sort(specialLayers, [](OutputLayer *left, OutputLayer *right) {
         return left->maxZpos() > right->maxZpos();
     });
