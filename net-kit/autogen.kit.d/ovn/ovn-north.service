[Unit]
Description=OVN northbound database server
Documentation=man:ovn-nb(5) man:ovn-nbctl(8)
After=syslog.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=OVN_RUNDIR=%t/ovn
Environment=OVN_DBDIR=/var/lib/ovn
EnvironmentFile=/etc/conf.d/ovn-north
ExecStart=/usr/share/ovn/scripts/ovn-ctl start_nb_ovsdb $OVN_CTL_OPTS
ExecStop=/usr/share/ovn/scripts/ovn-ctl stop_nb_ovsdb

[Install]
WantedBy=multi-user.target
