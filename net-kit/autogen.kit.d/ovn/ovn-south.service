[Unit]
Description=OVN southbound database server
Documentation=man:ovn-sb(5) man:ovn-sbctl(8)
After=syslog.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=OVN_RUNDIR=%t/ovn
Environment=OVN_DBDIR=/var/lib/ovn
EnvironmentFile=/etc/conf.d/ovn-south
ExecStart=/usr/share/ovn/scripts/ovn-ctl start_sb_ovsdb $OVN_CTL_OPTS
ExecStop=/usr/share/ovn/scripts/ovn-ctl stop_sb_ovsdb

[Install]
WantedBy=multi-user.target
