EAPI=7

inherit qt5-build

DESCRIPTION="Bluetooth support library for the Qt5 framework"
SRC_URI="{{.Values.src_uri}}"
SLOT=5

KEYWORDS="*"

IUSE="qml"

RDEPEND="
	=dev-qt/qtconcurrent-{{ .Values.version}}*
	=dev-qt/qtcore-{{ .Values.version}}*:5=
	=dev-qt/qtdbus-{{ .Values.version}}*
	>=net-wireless/bluez-5:=
	qml? ( =dev-qt/qtdeclarative-{{ .Values.version}}* )
"
DEPEND="${RDEPEND}
	=dev-qt/qtnetwork-{{ .Values.version}}*
"

src_prepare() {
	sed -i -e 's/nfc//' src/src.pro || die

	qt_use_disable_mod qml quick src/src.pro

	qt5-build_src_prepare
}
