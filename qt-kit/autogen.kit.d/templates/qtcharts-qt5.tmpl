EAPI=7

inherit qt5-build

DESCRIPTION="Chart component library for the Qt5 framework"
SRC_URI="{{.Values.src_uri}}"
SLOT=5
LICENSE="GPL-3"

KEYWORDS="*"

IUSE="qml"

DEPEND="
	=dev-qt/qtcore-{{ .Values.version}}*
	=dev-qt/qtgui-{{ .Values.version}}*
	=dev-qt/qtwidgets-{{ .Values.version}}*
	qml? ( =dev-qt/qtdeclarative-{{ .Values.version}}* )
"
RDEPEND="${DEPEND}"

src_prepare() {
	qt_use_disable_mod qml quick \
		src/src.pro

	qt5-build_src_prepare
}
