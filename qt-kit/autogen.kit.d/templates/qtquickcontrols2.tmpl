EAPI=7

inherit qt5-build

DESCRIPTION="Set of next generation Qt Quick controls for the Qt5 framework"
SRC_URI="{{.Values.src_uri}}"
SLOT=5

KEYWORDS="*"

IUSE="widgets"

DEPEND="
	=dev-qt/qtcore-{{ .Values.version}}*
	=dev-qt/qtdeclarative-{{ .Values.version}}*
	=dev-qt/qtgui-{{ .Values.version}}*
	widgets? ( =dev-qt/qtwidgets-{{ .Values.version}}* )
"
RDEPEND="${DEPEND}
	=dev-qt/qtgraphicaleffects-{{ .Values.version}}*
"

src_prepare() {
	qt_use_disable_mod widgets widgets \
		src/imports/platform/platform.pro

	qt5-build_src_prepare
}
