EAPI=7

inherit qt5-build

DESCRIPTION="SVG rendering library for the Qt5 framework"
SRC_URI="{{.Values.src_uri}}"
SLOT=5

KEYWORDS="*"

IUSE=""

RDEPEND="
	=dev-qt/qtcore-{{ .Values.version}}*
	=dev-qt/qtgui-{{ .Values.version}}*
	=dev-qt/qtwidgets-{{ .Values.version}}*
	sys-libs/zlib:=
"
DEPEND="${RDEPEND}
	test? ( =dev-qt/qtxml-{{ .Values.version}}* )
"
