EAPI=7

inherit qt5-build

DESCRIPTION="Implementation of the WebSocket protocol for the Qt5 framework"
SRC_URI="{{.Values.src_uri}}"
SLOT=5

KEYWORDS="*"

IUSE="qml +ssl"

DEPEND="
	=dev-qt/qtcore-{{ .Values.version}}*
	=dev-qt/qtnetwork-{{ .Values.version}}*[ssl=]
	qml? ( =dev-qt/qtdeclarative-{{ .Values.version}}* )

"
RDEPEND="${DEPEND}"

src_prepare() {
	qt_use_disable_mod qml quick src/src.pro

	qt5-build_src_prepare
}
